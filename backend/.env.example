# =============================================
# E-COMMERCE BACKEND ENVIRONMENT VARIABLES
# Copy this file to `.env` and fill in your values
# =============================================

# ---------- Server ----------
PORT=5000
NODE_ENV=development

# ---------- Database (PostgreSQL) ----------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ecommerce?schema=public"

# ---------- Redis ----------
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TLS=false

# ---------- JWT ----------
# Use a long random secret: `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRE=30d

# ---------- App URLs ----------
# Backend API base URL
BACKEND_URL=http://localhost:5000
# Frontend base URL (must match the Vite dev server port)
FRONTEND_URL=http://localhost:3005
# Comma-separated allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3005

# ---------- Google OAuth ----------
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Authorized redirect URI must be:
#   http://localhost:5000/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ---------- Facebook OAuth ----------
# Get these from https://developers.facebook.com/apps
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Valid OAuth Redirect URI must be:
#   http://localhost:5000/api/auth/facebook/callback
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# ---------- GitHub OAuth (optional) ----------
# Get these from https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Authorization callback URL must be:
#   http://localhost:5000/api/auth/github/callback
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# ---------- Email (SMTP) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="E-Shop <no-reply@yourshop.com>"

# ---------- Store ----------
STORE_NAME=E-Shop
STORE_DESCRIPTION=Your one-stop shop
STORE_KEYWORDS=ecommerce,shop,online store
STORE_OG_IMAGE=/default-og-image.jpg
