# =============================================
# E-COMMERCE BACKEND ENVIRONMENT VARIABLES
# Copy this file to `.env` and fill in your values
# =============================================

# ---------- Server ----------
NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3005

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3005

# ---------- Database (PostgreSQL) ----------
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ecommerce?schema=public

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TLS=false

# ---------- JWT / Security ----------
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE=30d

# ---------- Email (SMTP) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=E-Commerce <your-email@gmail.com>

# ---------- Store ----------
STORE_NAME=E-Shop
STORE_DESCRIPTION=Modern E-Commerce Store
STORE_OG_IMAGE=/default-og-image.jpg

# ---------- Google OAuth (Social Login) ----------
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ---------- Facebook OAuth (Social Login) ----------
# Create app at: https://developers.facebook.com/apps
# Valid OAuth Redirect URI must be: http://localhost:5000/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/auth/facebook/callback

# ---------- GitHub OAuth (Optional Social Login) ----------
# Create app at: https://github.com/settings/developers
# Authorization callback URL must be: http://localhost:5000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# ---------- Payment (Optional) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ---------- File Upload (Optional) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
</content>

